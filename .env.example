# Kopiér denne fil til ".env" (samme mappe som docker-compose.yml) og udfyld værdierne.
# ".env" er i .gitignore, så nøglen ikke ender i git.

# Delt nøgle til REST-API'et (/api/v1). Klienter sender den i headeren X-Api-Key.
# Er den tom, afvises alle API-kald. Generér fx en med:
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 32
API_SHARED_KEY=

# ── Ollama (AI-scan af opskrifter) ─────────────────────────────────────────────
# Er en linje udeladt eller tom, bruges standardværdien fra appsettings.json.

# Adressen på Ollama-serveren, inkl. /api til sidst.
OLLAMA_BASE_URL=http://10.64.50.30:11434/api

# API-nøgle, hvis Ollama står bag en proxy der kræver det (ellers tom).
OLLAMA_API_KEY=

# Model til AI-scan. Skal være hentet på serveren (ollama pull <model>) og kunne
# være i GPU'ens hukommelse (V100 med 16 GB — gemma4:12b bruger ca. 8,4 GB).
OLLAMA_CHAT_MODEL=gemma4:12b
OLLAMA_GENERATE_MODEL=gemma4:12b
