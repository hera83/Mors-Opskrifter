@* ── Opret ny opskrift – modal ─────────────────────────────────── *@
<div class="cr-backdrop js-cr-backdrop" aria-hidden="true"></div>

<div class="cr-modal js-cr-modal" role="dialog" aria-modal="true" aria-label="Opret ny opskrift">

    @* ── Header ─────────────────────────────────────────────────── *@
    <div class="cr-header">
        <button class="cr-close js-cr-close" type="button" title="Luk">
            <img src="~/icons/close.svg" alt="Luk" />
        </button>
        <span class="cr-title js-cr-modal-title">Ny opskrift</span>
        <button class="cr-ai-scan js-cr-ai-scan" type="button" title="AI Scan opskrift fra URL">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
            AI
        </button>
        <button class="cr-save js-cr-save" type="button">
            <img src="~/icons/save.svg" alt="" />
            Gem
        </button>
    </div>

    @* ── Body ───────────────────────────────────────────────────── *@
    <div class="cr-body">

        @* ─ Sektion 1: Grundinfo ─────────────────────────────────── *@
        <section class="cr-section">
            <h3 class="cr-section-title">Grundinfo</h3>

            <div class="cr-field">
                <label class="cr-label">Titel *</label>
                <input class="cr-input js-cr-title" type="text" placeholder="Fx. Kanelsnegle" maxlength="200" />
            </div>

            <div class="cr-row">
                <div class="cr-field cr-field--grow">
                    <label class="cr-label">Kategori</label>
                    <input class="cr-input js-cr-cat-value" type="text" list="cr-cat-datalist" placeholder="Vælg eller skriv kategori..." autocomplete="off" />
                    <datalist id="cr-cat-datalist" class="js-cr-cat-datalist"></datalist>
                    <input type="hidden" class="js-cr-caticon-value" value="cookie" />
                </div>
            </div>

            <div class="cr-row">
                <div class="cr-field">
                    <label class="cr-label">Forb. tid (min)</label>
                    <input class="cr-input cr-input--num js-cr-prep" type="number" min="0" value="0" />
                </div>
                <div class="cr-field">
                    <label class="cr-label">Tilb. tid (min)</label>
                    <input class="cr-input cr-input--num js-cr-cook" type="number" min="0" value="0" />
                </div>
                <div class="cr-field">
                    <label class="cr-label">Portioner</label>
                    <input class="cr-input cr-input--num js-cr-servings" type="number" min="1" value="4" />
                </div>
            </div>

            <div class="cr-field">
                <label class="cr-label">Sværhedsgrad</label>
                <div class="filter-chips cr-chips">
                    <button type="button" class="filter-chip cr-diff-chip" data-value="Let">Let</button>
                    <button type="button" class="filter-chip cr-diff-chip active" data-value="Middel">Middel</button>
                    <button type="button" class="filter-chip cr-diff-chip" data-value="Svær">Svær</button>
                </div>
            </div>
        </section>

        @* ─ Sektion 2: Billede ────────────────────────────────────── *@
        <section class="cr-section">
            <h3 class="cr-section-title">Billede</h3>
            <div class="cr-image-area js-cr-image-area">
                <img src="~/icons/camera.svg" class="cr-image-placeholder-icon" alt="" />
                <span class="cr-image-placeholder-text">Klik for at vælge billede</span>
                <input class="js-cr-image-input" type="file" accept="image/*" style="display:none;" />
                <img class="cr-image-preview js-cr-image-preview" src="" alt="Preview" style="display:none;" />
            </div>
        </section>

        @* ─ Sektion 3: Ingredienser ───────────────────────────────── *@
        <section class="cr-section">
            <h3 class="cr-section-title">Ingredienser</h3>

            <div class="cr-table-header">
                <span class="cr-col-amount">Mængde</span>
                <span class="cr-col-unit">Enhed</span>
                <span class="cr-col-name">Navn</span>
                <span class="cr-col-actions"></span>
            </div>

            <div class="cr-ing-list js-cr-ing-list">
                @* Rækker tilføjes dynamisk af JS *@
            </div>

            @* Datalists udfyldes dynamisk fra databasen *@
            <datalist id="ing-units-list"></datalist>
            <datalist id="ing-names-list"></datalist>

            <button type="button" class="cr-add-row-btn js-cr-add-ing">
                <img src="~/icons/plus.svg" alt="" /> Tilføj ingrediens
            </button>
        </section>

        @* ─ Sektion 4: Fremgangsmåde ─────────────────────────────── *@
        <section class="cr-section">
            <h3 class="cr-section-title">Fremgangsmåde</h3>

            <div class="cr-step-list js-cr-step-list">
                @* Trin tilføjes dynamisk af JS *@
            </div>

            <button type="button" class="cr-add-row-btn js-cr-add-step">
                <img src="~/icons/plus.svg" alt="" /> Tilføj trin
            </button>
        </section>

        @* ─ Sektion 5: Noter ─────────────────────────────────────── *@
        <section class="cr-section">
            <h3 class="cr-section-title">Noter</h3>
            <textarea class="cr-textarea js-cr-notes" rows="4" placeholder="Egne noter, tips, variationer…"></textarea>
        </section>

    </div>@* end cr-body *@
</div>@* end cr-modal *@

@* ── Beskær billede – overlay ──────────────────────────────────────── *@
<div class="crop-overlay js-crop-overlay" aria-hidden="true" style="display:none;">
    <div class="crop-dialog">
        <div class="crop-dialog-header">
            <span class="crop-dialog-title">Beskær billede (16:9)</span>
            <button type="button" class="crop-cancel-btn js-crop-cancel" title="Annuller">
                <img src="~/icons/close.svg" alt="Annuller" />
            </button>
        </div>
        <div class="crop-canvas-wrap js-crop-canvas-wrap">
            <canvas class="crop-canvas js-crop-canvas"></canvas>
            <div class="crop-box js-crop-box">
                <div class="crop-box-border"></div>
                <div class="crop-handle crop-handle-nw js-crop-nw"></div>
                <div class="crop-handle crop-handle-ne js-crop-ne"></div>
                <div class="crop-handle crop-handle-sw js-crop-sw"></div>
                <div class="crop-handle crop-handle-se js-crop-se"></div>
            </div>
        </div>
        <div class="crop-dialog-footer">
            <button type="button" class="crop-confirm-btn js-crop-confirm">Beskær og brug</button>
        </div>
    </div>
</div>

@* ── AI Scan – overlay ──────────────────────────────────────────────────── *@
<div class="ai-scan-overlay js-ai-scan-overlay" aria-hidden="true" style="display:none;">
    <div class="ai-scan-dialog">
        <div class="ai-scan-header">
            <span class="ai-scan-title">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
                AI Scan opskrift
            </span>
            <button type="button" class="ai-scan-close-btn js-ai-scan-close" title="Luk">
                <img src="~/icons/close.svg" alt="Luk" />
            </button>
        </div>
        <div class="ai-scan-body">
            <div class="ai-scan-input-row js-ai-scan-input-row">
                <input type="url" class="ai-scan-url-input js-ai-scan-url" placeholder="Indsæt URL til opskriften, fx. https://..." />
                <button type="button" class="ai-scan-btn js-ai-scan-submit">Scan</button>
            </div>
            <div class="ai-scan-status js-ai-scan-status" style="display:none;">
                <div class="ai-scan-spinner"></div>
                <span class="ai-scan-status-text js-ai-scan-status-text">Starter model…</span>
            </div>
            <div class="ai-scan-result js-ai-scan-result" style="display:none;"></div>
        </div>
        <div class="ai-scan-footer js-ai-scan-footer" style="display:none;">
            <button type="button" class="ai-scan-transfer-btn js-ai-scan-transfer">Overfør til opskrift</button>
        </div>
    </div>
</div>
