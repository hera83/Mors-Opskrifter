@model web.Controllers.LoginViewModel
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "";
}

<h1 class="auth-title">Velkommen tilbage</h1>
<p class="auth-sub">Log ind for at se opskrifterne</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="auth-error">
        @Html.ValidationSummary(false, "", new { @class = "auth-validation" })
    </div>
}

<form method="post" asp-action="Login" asp-controller="Auth" asp-route-returnUrl="@returnUrl">
    @Html.AntiForgeryToken()

    <div class="auth-field">
        <label asp-for="Username">Brugernavn</label>
        <input asp-for="Username" type="text" autocomplete="username" autofocus placeholder="Dit brugernavn" />
        <span asp-validation-for="Username" class="auth-field-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Password">Adgangskode</label>
        <input asp-for="Password" type="password" autocomplete="current-password" placeholder="Din adgangskode" />
        <span asp-validation-for="Password" class="auth-field-error"></span>
    </div>

    <div class="auth-remember">
        <label class="auth-check-label">
            <input asp-for="RememberMe" type="checkbox" />
            <span>Husk mig</span>
        </label>
    </div>

    <button type="submit" class="auth-btn">Log ind</button>
</form>
